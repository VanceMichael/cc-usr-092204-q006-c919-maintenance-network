{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "维修方案",
  "type": "object",
  "required": ["id", "revision", "effectiveFrom", "appliesToConfigs", "tasks"],
  "properties": {
    "id": { "type": "string" },
    "revision": { "type": "string", "description": "方案版本" },
    "effectiveFrom": { "type": "string", "description": "生效日期" },
    "appliesToConfigs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "适用构型"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["card", "level"],
        "properties": {
          "card": { "type": "string", "description": "工卡号" },
          "level": { "type": "string", "enum": ["航线维修", "A检", "C检", "深度定检"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
